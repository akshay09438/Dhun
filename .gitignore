# Secrets — never commit
.env
.env.*
!.env.example
*secret*

# Audio & user data — large/binary, live in storage not git
data/
*.wav
*.mp3
*.flac
*.m4a
*.ogg

# Dependencies / builds
node_modules/
dist/
build/
.vite/
coverage/

# Python
__pycache__/
*.pyc
.venv/
.venv-x64/
venv/
.pytest_cache/

# Editor / OS
.DS_Store
Thumbs.db

# Zuko backups + transient state
*.pre-zuko.bak
.zuko/approvals.json

# Local editor/tooling settings (keep launch.json shared)
.claude/settings.local.json
services/api/_candidate_preload.py

# Which artwork the bot last uploaded, per slot (per-installation state, not source).
# A pattern, not one filename: the avatar was the only slot until the profile banner was added,
# and a new marker silently showing up as untracked is easy to commit by accident.
services/discord-bot/assets/.applied-*

# The bot's own small database (grind numbers, reactions). Local state, not source.
services/discord-bot/data/
